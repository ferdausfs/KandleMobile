<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kandle_bg"
    android:orientation="vertical">

    <View
        android:id="@+id/status_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/kandle_panel" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:progressTint="@color/kandle_accent"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/kandle_bg" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/nav_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kandle_panel">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/kandle_border" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/kandle_panel"
            app:itemActiveIndicatorStyle="@style/KandleNavIndicator"
            app:itemIconTint="@color/kandle_nav_tint"
            app:itemTextColor="@color/kandle_nav_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_menu" />

        <View
            android:id="@+id/nav_tick"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_nav_tick"
            android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
